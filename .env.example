# Firebase Web Configuration for Smart CSE Timetable System
# Obtain these values from your Firebase Project Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
VITE_FIREBASE_AUTH_DOMAIN=cse-timetable.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cse-timetable-app
VITE_FIREBASE_STORAGE_BUCKET=cse-timetable-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
